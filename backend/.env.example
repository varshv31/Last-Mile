# ─── Application ───────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true
APP_NAME="Last-Mile Delivery Tracker"
APP_VERSION=1.0.0

# ─── PostgreSQL ─────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://lmd_user:lmd_password@localhost:5432/lmd_db

# ─── JWT ────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=changeme_use_openssl_rand_hex_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── CORS ───────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── Email (SMTP) ───────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM=your_email@gmail.com
EMAIL_FROM_NAME="LMD Tracker"

# Set to true to skip actual email delivery in development
EMAIL_DISABLED=true

# ─── SMS (Twilio) ───────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1xxxxxxxxxx

# Set to true to skip SMS delivery (no-op mode)
SMS_DISABLED=true

# ─── Redis (for future Celery integration) ──────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Rate Calculation ───────────────────────────────────────
# Divisor for volumetric weight calculation (cm³ to kg)
VOLUMETRIC_DIVISOR=5000
